# ============================================================================
# ragkb 配置示例：复制为 .env 后按需修改
#   所有变量以 RAGKB_ 为前缀；进程环境变量优先于本文件。
#
# 默认配置是「完全离线可跑」的：本地词法向量 + 抽取式生成。
# 想接真实模型，只需改 LLM/EMBED 两组（任何 OpenAI 兼容网关都行）。
# ============================================================================

# ---- 目录与存储 ------------------------------------------------------------
RAGKB_DATA_DIR=./data
RAGKB_DB_PATH=./data/ragkb.sqlite3
RAGKB_TRACE_ENABLED=true
# 成本统计用的价格表在 ragkb/config.py 的 price_table，按需增删模型

# ---- Embedding -------------------------------------------------------------
# hashing : 本地词法向量（零依赖、离线可用；同义改写基本失效，适合开发/测试/兜底）
# onnx    : 本地**语义**模型（ONNX Runtime + BGE，23MB，无需 torch）——见 README「实测」一节
# openai  : 任何 OpenAI 兼容 /embeddings 网关
RAGKB_EMBED_PROVIDER=hashing
RAGKB_EMBED_MODEL=hashing-512
RAGKB_EMBED_DIM=512

# 本语义 embedding（推荐在"用户会用自己的话提问"时启用）：
#   1) python scripts/fetch_model.py
#   2) pip install "onnxruntime>=1.19.2,<1.20" tokenizers
#      注意：1.30.0 在 Anaconda 版 Python 上加载原生模块会崩溃（访问冲突），故暂不上探
#   3) 取消下面注释，然后 `ingest ./data/corpus --force` 重建索引
# RAGKB_EMBED_PROVIDER=onnx
# RAGKB_EMBED_MODEL=bge-small-zh-v1.5
# RAGKB_EMBED_DIM=512
# RAGKB_ONNX_MODEL_DIR=./models/bge-small-zh-v1.5
# RAGKB_ONNX_MAX_LENGTH=512
# RAGKB_ONNX_POOLING=cls

# 云端 embedding（示例：SiliconFlow 上的 BGE-M3）
# RAGKB_EMBED_PROVIDER=openai
# RAGKB_EMBED_MODEL=BAAI/bge-m3
# RAGKB_EMBED_BASE_URL=https://api.siliconflow.cn/v1
# RAGKB_EMBED_API_KEY=sk-xxxx
# RAGKB_EMBED_DIM=1024
# RAGKB_EMBED_BATCH_SIZE=32
# 注意：换 embedding 模型后必须 `ingest --force` 重建，否则新旧向量不在同一空间

# ---- 生成模型 --------------------------------------------------------------
# scripted : 本地抽取式基线（离线、确定性，用于测试与对照实验）
# openai   : 任何 OpenAI 兼容 /chat/completions
RAGKB_LLM_PROVIDER=scripted
RAGKB_LLM_MODEL=gpt-4o-mini
RAGKB_LLM_TEMPERATURE=0.0
RAGKB_LLM_MAX_TOKENS=900

# 示例 A：DeepSeek
# RAGKB_LLM_PROVIDER=openai
# RAGKB_LLM_MODEL=deepseek-chat
# RAGKB_LLM_BASE_URL=https://api.deepseek.com/v1
# RAGKB_LLM_API_KEY=sk-xxxx
#
# 示例 B：本地 vLLM / Ollama（OpenAI 兼容）
# RAGKB_LLM_BASE_URL=http://127.0.0.1:8000/v1
# RAGKB_LLM_MODEL=Qwen2.5-7B-Instruct
# RAGKB_LLM_API_KEY=EMPTY

# ---- 重排 ------------------------------------------------------------------
# none    : 关闭
# lexical : 本地词法交叉打分（零依赖，可解释）
# http    : Cohere / Jina / SiliconFlow 风格 POST /rerank，失败自动降级到 lexical
RAGKB_RERANK_PROVIDER=lexical
RAGKB_LEXICAL_RERANK_WEIGHT=0.65

# RAGKB_RERANK_PROVIDER=http
# RAGKB_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RAGKB_RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RAGKB_RERANK_API_KEY=sk-xxxx

# ---- 切块 ------------------------------------------------------------------
# 技术文档 600~900 比较合适；制度类可放宽到 800~1200
RAGKB_CHUNK_SIZE=800
RAGKB_CHUNK_OVERLAP=120
RAGKB_CHUNK_MIN_CHARS=120

# ---- 检索 ------------------------------------------------------------------
RAGKB_RETRIEVE_CANDIDATES=50     # 每个通道召回条数
RAGKB_FUSE_TOP_K=20              # RRF 融合后送重排的条数（同时是单通道截断长度）
RAGKB_FINAL_TOP_K=6              # 最终送进模型的上下文条数
RAGKB_RRF_K=60
# 向量最低相似度：真实 embedding 建议 0.15~0.25；本地 hashing 兜底向量整体偏高，保持 0
RAGKB_VECTOR_MIN_SIMILARITY=0.0

# ---- 拒答门禁 --------------------------------------------------------------
# refuse_coverage_floor 是最关键的一条：查询词（IDF 加权）在上下文中的覆盖率下限。
# 0.25 由 scripts/sweep_refusal.py 在评测集上扫描得到：误答率 0、误拒率 0.227。
# 注意：再放宽（0.10）时误答率会涨到 0.50——纯词法门禁的极限就在这，想继续降误拒只能靠语义信号。
# 调高更保守（宁可说不知道），调低更激进。误答比误拒更伤信任，所以宁高勿低。
RAGKB_REFUSE_COVERAGE_FLOOR=0.25
RAGKB_REFUSE_SCORE_FLOOR=0.02
RAGKB_REFUSE_MIN_HITS=1

# 语义豁免：向量通道最高相似度达到该值时跳过词法覆盖率门禁。
# 用真实 embedding 时**必须**一起设置，否则检索侧的语义收益会在拒答环节被抵消
# （实测：只换 embedding 不设它，拒答准确率反而从 0.808 掉到 0.769；设了之后升到 0.885，误答仍为 0）。
# 本地 bge-small-zh 建议 0.58；云端 bge-m3 分布不同，建议 0.45~0.55 并用 sweep 脚本扫一遍。
RAGKB_REFUSE_VECTOR_SIMILARITY_FLOOR=0.0

# ---- HTTP 服务 -------------------------------------------------------------
RAGKB_API_HOST=127.0.0.1
RAGKB_API_PORT=8000
# 对外暴露时务必设置；健康检查 /health 不受影响（供探针使用）
RAGKB_API_KEY=
RAGKB_DEFAULT_ROLES=public
RAGKB_MAX_UPLOAD_MB=20
